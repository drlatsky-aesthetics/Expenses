# --- Mailbox (required for email scanning) ---
# Gmail app password for the receipts mailbox (IMAP). Set the real value on Vercel.
GOOGLE_PASSWORD=
# Mailbox address. Defaults to latskymd.receipts@gmail.com when unset.
GOOGLE_EMAIL=latskymd.receipts@gmail.com
# Optional: IMAP folder to scan (default INBOX). "[Gmail]/All Mail" scans archived mail too.
IMAP_MAILBOX=INBOX
# Optional: on the very first scan, ignore mail older than this date (YYYY-MM-DD).
MAIL_SINCE=
# After processing, mail is labeled, marked read and archived. Set false to leave it in the inbox.
MAIL_ARCHIVE=true
MAIL_LABEL_PROCESSED=Expenses/Processed
MAIL_LABEL_SKIPPED=Expenses/Skipped

# --- Receipt reading (strongly recommended) ---
# With a key, photos, PDFs and HTML receipts are read and categorized by Claude.
# Without one, a regex-based fallback handles text/HTML receipts only.
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5).
CLAUDE_MODEL=

# --- Storage ---
# Vercel Blob token. Set automatically on Vercel by the linked "expenses-receipts" store.
# Leave empty locally to use ./.data instead.
BLOB_READ_WRITE_TOKEN=

# --- Access control (optional but recommended once Vercel deployment protection is off) ---
# Usernames that share APP_PASSWORD, comma-separated.
APP_USERS=admin
APP_PASSWORD=
# Vercel Cron sends this as a bearer token so the daily scan can run behind APP_PASSWORD.
CRON_SECRET=

# --- Practice details printed on reports ---
PRACTICE_NAME=
DEFAULT_CURRENCY=CAD
